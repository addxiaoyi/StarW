{
  "name": "@openstar/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "openstar": "./src/bin.ts"
  },
  "scripts": {
    "dev": "bun run src/bin.ts",
    "start": "bun run src/bin.ts",
    "typecheck": "bun x tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/bin.ts --outdir dist --target node --format esm --packages external"
  },
  "dependencies": {
    "@openstar/core": "workspace:*",
    "@openstar/swarm": "workspace:*",
    "@openstar/gateway": "workspace:*",
    "cac": "^6.7.14",
    "effect": "^4.0.0-beta.83",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^24.12.2",
    "typescript": "^7.0.2"
  }
}
