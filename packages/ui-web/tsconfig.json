{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": [
      "node",
      "bun"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@openstar/core": [
        "../core/src/index.ts"
      ],
      "@openstar/canvas": [
        "../canvas/src/index.ts"
      ],
      "@openstar/browser": [
        "../browser/src/index.ts"
      ],
      "@openstar/pet": [
        "../pet/src/index.ts"
      ],
      "@openstar/templates": [
        "../templates/src/index.ts"
      ],
      "@openstar/relay": [
        "../relay/src/index.ts"
      ],
      "@openstar/swarm": [
        "../swarm/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
