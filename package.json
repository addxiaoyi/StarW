{
  "name": "openstar",
  "description": "StarCore - Ultra-high performance terminal management agent with Skill + MCP ecosystem and Agent Swarm",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.0"
  },
  "version": "0.1.0",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "dev": "bun run --cwd packages/ui-web dev",
    "dev:cli": "bun run --cwd packages/cli dev",
    "dev:ui": "bun run --cwd packages/ui-web dev",
    "build": "bun run --cwd packages/ui-web build",
    "build:cli": "bun run --cwd packages/cli build",
    "build:ui": "bun run --cwd packages/ui-web build",
    "build:desktop": "bun run build:ui && bun run --cwd packages/desktop-electron build",
    "typecheck": "node scripts/typecheck-packages.mjs",
    "typecheck:ui": "bun run --cwd packages/ui-web typecheck",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\"",
    "format:check": "node scripts/check-prettier-baseline.mjs",
    "lint": "bun run typecheck",
    "lint:strict": "bun run typecheck",
    "test": "vitest run && bun run --cwd packages/desktop-electron test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:core": "vitest run packages/core/src",
    "test:swarm": "vitest run packages/swarm/src",
    "test:mcp": "vitest run packages/mcp/src",
    "test:ui": "vitest run packages/ui-web/src",
    "test:desktop": "vitest run packages/desktop-electron/test && bun run --cwd packages/desktop-electron test",
    "presubmit": "bun run format:check && bun run lint && bun run test",
    "dev:desktop": "bash scripts/dev-desktop.sh",
    "electron": "cd packages/desktop-electron && node ../../node_modules/.bin/electron .",
    "bootstrap": "bun run scripts/bootstrap.sh",
    "package:cli": "bun run build:cli && bun build packages/cli/src/index.ts --outdir dist --target node --format esm",
    "package:binary": "bun run scripts/package-binary.sh",
    "typecheck:legacy": "bun x tsc --noEmit",
    "format:strict": "prettier --check \"packages/*/src/**/*.{ts,tsx}\"",
    "smoke:providers:live": "bun run --cwd packages/relay smoke:live"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dockerode": "^4.0.4",
    "effect": "^4.0.0-beta.83",
    "electron": "^43.1.0",
    "glob": "^13.0.6",
    "openai": "^4.86.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/dockerode": "^3.3.35",
    "@types/glob": "^9.0.0",
    "@types/node": "^24.12.2",
    "@vitest/coverage-v8": "^2.1.8",
    "cac": "^7.0.0",
    "picocolors": "^1.1.1",
    "prettier": "^3.5.3",
    "typescript": "^7.0.2",
    "ulid": "^3.0.2",
    "vitest": "^2.1.8"
  }
}
